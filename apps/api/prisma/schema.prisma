generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id               String   @id
  countryCode      String
  nameFr           String
  nameEn           String?
  defaultLocale    String   @default("fr")
  currency         String   @default("XOF")
  ussdShortCode    String
  voiceShortNumber String
  smsSenderId      String
  modulesJson      String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  cases            Case[]
  payments         Payment[]
  notifications    Notification[]
  sessions         ChannelSession[]
}

model Case {
  id              String   @id @default(cuid())
  trackingNumber  String   @unique
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id])
  serviceCode     String
  journeyId       String
  journeyVersion  String
  status          String
  channel         String
  phoneNumber     String
  locale          String   @default("fr")
  payloadJson     String   @default("{}")
  feeAmount       Int
  feeCurrency     String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  payments        Payment[]
  notifications   Notification[]
  statusEvents    CaseStatusEvent[]

  @@index([tenantId, phoneNumber])
  @@index([status])
}

model CaseStatusEvent {
  id        String   @id @default(cuid())
  caseId    String
  case      Case     @relation(fields: [caseId], references: [id])
  fromStatus String?
  toStatus  String
  actor     String
  note      String?
  createdAt DateTime @default(now())

  @@index([caseId])
}

model Payment {
  id              String   @id @default(cuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id])
  caseId          String
  case            Case     @relation(fields: [caseId], references: [id])
  provider        String   @default("simulator")
  amount          Int
  currency        String
  status          String
  externalRef     String?
  phoneNumber     String
  idempotencyKey  String   @unique
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([caseId])
}

model Notification {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  caseId      String?
  case        Case?    @relation(fields: [caseId], references: [id])
  channel     String
  recipient   String
  senderId    String
  body        String
  status      String
  provider    String   @default("simulator")
  costEstimate Float?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId, createdAt])
}

model ChannelSession {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  channel      String
  phoneNumber  String
  locale       String   @default("fr")
  journeyId    String?
  currentStepId String?
  answersJson  String   @default("{}")
  caseId       String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([tenantId, phoneNumber, channel])
}

model Instructor {
  id           String   @id @default(cuid())
  tenantId     String
  email        String
  name         String
  passwordHash String
  role         String   @default("instructor")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([tenantId, email])
  @@index([tenantId])
}
