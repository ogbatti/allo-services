{
  "id": "bill-payment",
  "version": "1.0.0",
  "tenantId": "tg",
  "serviceCode": "PAY_FACTURE",
  "title": {
    "fr": "Paiement de facture",
    "ee": "Akɔnta gaƒoƒo",
    "en": "Bill payment"
  },
  "feeAmount": 1000,
  "feeCurrency": "XOF",
  "startStepId": "input_provider",
  "steps": [
    {
      "id": "input_provider",
      "type": "menu",
      "field": "provider",
      "prompt": {
        "fr": "Paiement facture\n1. Eau (TdE)\n2. Électricité (CEET)\n3. Taxe locale\n0. Agent",
        "ee": "Akɔnta gaƒoƒo\n1. Tsi\n2. Kɛdzi\n3. Duƒoƒo ga\n0. Ame",
        "en": "Bill payment\n1. Water\n2. Electricity\n3. Local tax\n0. Agent"
      },
      "options": [
        { "key": "1", "label": { "fr": "Eau", "en": "Water", "ee": "Tsi" }, "next": "input_ref" },
        { "key": "2", "label": { "fr": "Électricité", "en": "Electricity", "ee": "Kɛdzi" }, "next": "input_ref" },
        { "key": "3", "label": { "fr": "Taxe", "en": "Tax", "ee": "Ga" }, "next": "input_ref" },
        { "key": "0", "label": { "fr": "Agent", "en": "Agent", "ee": "Ame" }, "next": "end_agent" }
      ]
    },
    {
      "id": "input_ref",
      "type": "input",
      "prompt": {
        "fr": "Référence client / n° facture ?",
        "ee": "Asiŋu / akɔnta xexlẽdzesi?",
        "en": "Customer / bill reference?"
      },
      "field": "billReference",
      "validation": { "minLength": 4, "maxLength": 40 },
      "next": "input_amount"
    },
    {
      "id": "input_amount",
      "type": "input",
      "prompt": {
        "fr": "Montant à payer (XOF) ?",
        "ee": "Ga si nàƒo (XOF)?",
        "en": "Amount to pay (XOF)?"
      },
      "field": "billAmount",
      "validation": { "pattern": "^[0-9]{2,7}$" },
      "next": "confirm_pay"
    },
    {
      "id": "confirm_pay",
      "type": "confirm",
      "prompt": {
        "fr": "Confirmer le paiement mobile money ?\n1. Oui\n2. Non",
        "ee": "Ðo kpe mobile money gaƒoƒo?\n1. Ɛ\n2. Ao",
        "en": "Confirm mobile money payment?\n1. Yes\n2. No"
      },
      "options": [
        { "key": "1", "label": { "fr": "Oui", "en": "Yes", "ee": "Ɛ" }, "next": "payment" },
        { "key": "2", "label": { "fr": "Non", "en": "No", "ee": "Ao" }, "next": "end_cancelled" }
      ]
    },
    {
      "id": "payment",
      "type": "payment",
      "prompt": {
        "fr": "Paiement en cours…",
        "ee": "Gaƒoƒo le edzi…",
        "en": "Payment in progress…"
      },
      "next": "end_success"
    },
    {
      "id": "end_success",
      "type": "end",
      "prompt": {
        "fr": "Paiement enregistré. Suivi: {{trackingNumber}}. Reçu envoyé par SMS.",
        "ee": "Gaƒoƒo wɔe. Dzodzro: {{trackingNumber}}.",
        "en": "Payment recorded. Tracking: {{trackingNumber}}."
      }
    },
    {
      "id": "end_cancelled",
      "type": "end",
      "prompt": {
        "fr": "Paiement annulé.",
        "ee": "Gaƒoƒo wotɔ.",
        "en": "Payment cancelled."
      }
    },
    {
      "id": "end_agent",
      "type": "end",
      "prompt": {
        "fr": "Un agent vous rappellera sous peu.",
        "ee": "Ame aɖe agblɔ na wò kaba.",
        "en": "An agent will call you shortly."
      }
    }
  ]
}
