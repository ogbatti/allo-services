{
  "id": "civil-status-birth-certificate",
  "version": "1.0.0",
  "tenantId": "tg",
  "serviceCode": "ETC_ACTE_NAISSANCE",
  "title": {
    "fr": "Demande d'acte de naissance",
    "ee": "Dzidzɔ ŋkɔ ŋuti agbalẽ biabia",
    "en": "Birth certificate request"
  },
  "feeAmount": 500,
  "feeCurrency": "XOF",
  "startStepId": "input_child_name",
  "steps": [
    {
      "id": "input_child_name",
      "type": "input",
      "prompt": {
        "fr": "Nom complet de l'enfant ?",
        "ee": "Ɖevi ŋkɔ blibo?",
        "en": "Child's full name?"
      },
      "field": "childFullName",
      "validation": { "minLength": 2, "maxLength": 80 },
      "next": "input_birth_date"
    },
    {
      "id": "input_birth_date",
      "type": "input",
      "prompt": {
        "fr": "Date de naissance (JJ/MM/AAAA) ?",
        "ee": "Dzidzɔ ŋkeke (ŊD/ŊA/ƑE)?",
        "en": "Date of birth (DD/MM/YYYY)?"
      },
      "field": "birthDate",
      "validation": { "pattern": "^\\d{2}/\\d{2}/\\d{4}$" },
      "next": "input_commune"
    },
    {
      "id": "input_commune",
      "type": "input",
      "prompt": {
        "fr": "Commune d'enregistrement ?",
        "ee": "Nɔƒe si me wode ɖe?",
        "en": "Registration commune?"
      },
      "field": "commune",
      "validation": { "minLength": 2, "maxLength": 60 },
      "next": "confirm_summary"
    },
    {
      "id": "confirm_summary",
      "type": "confirm",
      "prompt": {
        "fr": "Confirmer la demande (frais 500 XOF) ?\n1. Oui\n2. Non",
        "ee": "Ðo kpe biabia (ga 500 XOF)?\n1. Ɛ\n2. Ao",
        "en": "Confirm request (fee 500 XOF)?\n1. Yes\n2. No"
      },
      "options": [
        { "key": "1", "label": { "fr": "Oui", "en": "Yes", "ee": "Ɛ" }, "next": "payment" },
        { "key": "2", "label": { "fr": "Non", "en": "No", "ee": "Ao" }, "next": "end_cancelled" }
      ]
    },
    {
      "id": "payment",
      "type": "payment",
      "prompt": {
        "fr": "Paiement mobile money de 500 XOF en cours…",
        "ee": "Mobile money gaƒoƒo 500 XOF le edzi…",
        "en": "Mobile money payment of 500 XOF in progress…"
      },
      "next": "end_success"
    },
    {
      "id": "end_success",
      "type": "end",
      "prompt": {
        "fr": "Demande enregistrée. Numéro de suivi: {{trackingNumber}}. Un SMS de confirmation vous a été envoyé.",
        "ee": "Biabia wɔe. Dzodzro xexlẽdzesi: {{trackingNumber}}. SMS ɖeka ɖo wò.",
        "en": "Request registered. Tracking number: {{trackingNumber}}. A confirmation SMS was sent."
      }
    },
    {
      "id": "end_cancelled",
      "type": "end",
      "prompt": {
        "fr": "Demande annulée. Composez *855# pour recommencer.",
        "ee": "Biabia wotɔ. Ŋlɔ *855# be nàgbugbɔ adze egɔme.",
        "en": "Request cancelled. Dial *855# to start again."
      }
    },
    {
      "id": "end_agent",
      "type": "end",
      "prompt": {
        "fr": "Un agent vous rappellera sous peu. Merci.",
        "ee": "Ame aɖe agblɔ na wò kaba. Akpe.",
        "en": "An agent will call you shortly. Thank you."
      }
    }
  ]
}
